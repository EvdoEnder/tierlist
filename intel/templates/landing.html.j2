{% extends "_base.html.j2" %}
{% from "_parts.html.j2" import entry, bands, boards, trending_boards, page_head, period_big with context %}
{% block title %}tierlist.tech {{ ctx.edition_label }}{% endblock %}
{% block lede %}
{{ page_head(period_big('daily', ctx.period_label or ctx.date), t('sec.daily_title'), 'lede.created_range', 'lede.headline_daily') }}
{% endblock %}
{% block content %}
{% set top_tier = ctx.lede.top_tier if 'top_tier' in ctx.lede else (ctx.lede.top_score|tier) %}
{% if ctx.entries and top_tier and top_tier not in ('S', 'A') %}
<p class="notice">{{ t('sec.below_line', top=top_tier) }}</p>
{% endif %}
{{ bands(ctx.entries) }}

{# Same Show HN board as the issue page — see issue.html.j2. #}
{% if ctx.hn_entries %}
<section class="index band-hn" aria-labelledby="band-hn">
  <h2 class="index-h" id="band-hn">Show HN <span class="board-k num">{{ ctx.hn_entries|length }}</span></h2>
  {% for e in ctx.hn_entries %}{{ entry(e, e.tier if 'tier' in e else (e.score|tier)) }}{% endfor %}
</section>
{% endif %}

{{ boards(ctx.gain_board, ctx.hot_new, ctx.news_rows) }}
{{ trending_boards(ctx.trending) }}

<section class="recent" aria-label="{{ t('sec.sections') }}">
  {% for key in ['daily', 'weekly', 'monthly'] %}
  <div class="recent-col">
    <h2 class="board-h"><a href="{{ ctx.nav[key] }}">{{ t('cross.' ~ key) }}</a></h2>
    <ul class="recent-list">{% for i in recent[key] %}<li><a class="num" href="{{ i.url }}">{{ i.date }}</a></li>{% endfor %}</ul>
  </div>
  {% endfor %}
</section>
{% endblock %}
{% block footright %}{{ t('foot.updated') }} {{ ctx.date }}{% endblock %}
