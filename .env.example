# Template only. Copy to .env and fill in; never commit a real .env.

# Recommended: a fine-grained token with no extra permissions. Without one,
# GitHub's anonymous search limit cuts the recently-public source short and
# the daily star refresh does not run (GraphQL refuses anonymous requests).
GITHUB_TOKEN=

## LLM scorer. tierlist.tech runs on DeepSeek, and that is the default:
## set DEEPSEEK_API_KEY and nothing else.
DEEPSEEK_API_KEY=
# TIERLIST_LLM_MODEL=deepseek-flash

## Any other AI service with an OpenAI-compatible /chat/completions API
## works too. Set these three and leave DEEPSEEK_API_KEY empty; the model id
## is the one that service uses.
# TIERLIST_LLM_BASE_URL=
# TIERLIST_LLM_API_KEY=
# TIERLIST_LLM_MODEL=

## Postgres store. The engine creates and migrates the `intel` schema itself.
## Example: postgresql://user:pass@localhost/dbname
TIERLIST_PG_DSN=

## Public origin used in feed, canonical and sitemap URLs.
# TIERLIST_SITE_URL=https://tierlist.tech

## Where the static site is written; defaults to data/web/ under the project.
# TIERLIST_WEB_DIR=
